# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# 环境与密钥（严禁入库）
.env
.env.*
!.env.example

# 本地数据与产出
data/out/
data/tmp/
*.log

# 外部数据集原始件（切片 6.5）：体积大且可由 scripts/fetch_datasets.py 复拉，
# 仓库里只保留 manifest（含 SHA256）、校准结果与映射表。
data/external/_raw/

# 评测报告产出（切片 8.1）：每次跑批生成的 JSON 存档不入库，
# 结论以 docs/ROADMAP.md 与 docs/HANDOFF.md 的记录为准，避免仓库被产出文件淹没。
reports/

# worktree（独立工作目录，不入库）
.worktrees/

# 编辑器
.vscode/
.idea/